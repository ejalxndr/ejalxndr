server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ethanjalexander.ca www.ethanjalexander.ca;

    ssl_certificate     /etc/nginx/ssl/ethanjalexander.pem;
    ssl_certificate_key /etc/nginx/ssl/ethanjalexander.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/ethanjalexander.log;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
